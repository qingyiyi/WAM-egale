+// 单个Self Q/K/V tile：96任务中的一个；两段K累加及BF16提交原样保留。
+__device__ __forceinline__ void self_qkv8_tile(CutlassSelfQKV8::Storage &s,
+        const B *a, const B *w, const B *bias, B *out, int task) {
+    using Mma = CutlassSelfQKV8::Mma;
+    constexpr int m=224, n=3072, k=3072, span=1536, splits=2;
+    const int rm=(task/24)*64, cn=(task%24)*128;
+    const int thread=int(threadIdx.x), warp=thread/32, lane=thread%32;
+    for (int partition=0; partition<splits; ++partition) {
+        typename Mma::IteratorA::Params ap{CutlassRow(k)};
+        typename Mma::IteratorB::Params bp{CutlassCol(k)};
+        typename Mma::IteratorA ai(ap, reinterpret_cast<CutlassB *>(const_cast<B *>(a))+partition*span,
+                                  {m,span},thread,{rm,0});
+        typename Mma::IteratorB bi(bp, reinterpret_cast<CutlassB *>(const_cast<B *>(w))+partition*span,
+                                  {span,n},thread,{0,cn});
+        Mma mma(s.mainloop,thread,warp,lane);
+        typename Mma::FragmentC acc; acc.clear();
+        mma(span/64,acc,ai,bi,acc);
+        __syncthreads();
+        typename Mma::Operator::IteratorC store({s.result,CutlassRow(136)},lane);
+        store.add_tile_offset({warp%2,warp/2});
+        store.store(acc);
+        __syncthreads();
+
+            // 四元素向量仅减少搬运指令；FP32加法及BF16舍入仍逐元素保持。
+            struct alignas(8) B4 {
+                __nv_bfloat162 lo, hi;
+            };
+            for (int i = 4 * int(threadIdx.x); i < 64 * 128; i += 4 * int(blockDim.x)) {
+                const int r = rm + i / 128, c = cn + i % 128;
+                if (r < m && c < n) {
+                    float4 z =
+                        *reinterpret_cast<const float4 *>(s.result + (i / 128) * 136 + i % 128);
+                    if (partition == splits - 1) {
+                        B4 b = *reinterpret_cast<const B4 *>(bias + c);
+                        float2 lo = __bfloat1622float2(b.lo), hi = __bfloat1622float2(b.hi);
+                        z.x = __fadd_rn(z.x, lo.x);
+                        z.y = __fadd_rn(z.y, lo.y);
+                        z.z = __fadd_rn(z.z, hi.x);
+                        z.w = __fadd_rn(z.w, hi.y);
+                    }
+                    if (partition > 0) {
+                        B4 p = *reinterpret_cast<const B4 *>(out + r * n + c);
+                        float2 lo = __bfloat1622float2(p.lo), hi = __bfloat1622float2(p.hi);
+                        z.x = __fadd_rn(z.x, lo.x);
+                        z.y = __fadd_rn(z.y, lo.y);
+                        z.z = __fadd_rn(z.z, hi.x);
+                        z.w = __fadd_rn(z.w, hi.y);
+                    }
+                    *reinterpret_cast<B4 *>(out + r * n + c) = {__floats2bfloat162_rn(z.x, z.y),
+                                                                __floats2bfloat162_rn(z.z, z.w)};
+                }
+            }
+        __syncthreads();
+    }
+}
