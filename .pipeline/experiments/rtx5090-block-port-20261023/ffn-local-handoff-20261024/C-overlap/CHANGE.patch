+// C: the original partition-major queue; only the owner warp claims tasks.
+__device__ __forceinline__ int ffn2_claim_task(const Params &p) {
+    constexpr int count=168;
+    for (;;) {
+        for(int scan=0;scan<4;++scan) {
+            const int row=(int(blockIdx.x)+scan)%4,first=2*(row/2);
+            if(DeviceCounter(p.ffn_state[first]).load(cuda::memory_order_acquire)!=28 ||
+               DeviceCounter(p.ffn_state[first+1]).load(cuda::memory_order_acquire)!=(row<2?28:36))continue;
+            auto next=DeviceCounter(p.ffn_state[4+row]);
+            int job=next.load(cuda::memory_order_relaxed);
+            while(job<count && !next.compare_exchange_weak(job,job+1,cuda::memory_order_relaxed)){}
+            if(job<count)return row*count+job;
+        }
+        if(DeviceCounter(p.ffn_state[4]).load(cuda::memory_order_relaxed)==count &&
+           DeviceCounter(p.ffn_state[5]).load(cuda::memory_order_relaxed)==count &&
+           DeviceCounter(p.ffn_state[6]).load(cuda::memory_order_relaxed)==count &&
+           DeviceCounter(p.ffn_state[7]).load(cuda::memory_order_relaxed)==count)return -2;
+        __nanosleep(128);
+    }
