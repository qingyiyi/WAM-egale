+__device__ __forceinline__ void ffn2_tma_partition(const Params &p, ProjectionTmaStorage &s,
+                                                 int tile, int partition) {
+    using Op = typename CutlassTile<64>::Mma::Operator;
+    const int w = int(threadIdx.x)/32, lane = int(threadIdx.x)%32;
+    const int rm = tile/24*64, cn = tile%24*128;
+    if (threadIdx.x == 0) {
+        for (int i=0;i<2;++i) {
+            asm volatile("mbarrier.init.shared::cta.b64 [%0], 1;" :: "r"(projection_smem(&s.ready[i])) : "memory");
+            asm volatile("mbarrier.init.shared::cta.b64 [%0], 4;" :: "r"(projection_smem(&s.empty[i])) : "memory");
+        }
+        asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    }
+    __syncthreads();
+    if (w == 0) {
+        for (int step=0;step<32;++step) {
+            const int slot=step&1;
+            if (step>=2) projection_wait(&s.empty[slot],((step/2)-1)&1);
+            if (lane==0) {
+                const unsigned barrier=projection_smem(&s.ready[slot]);
+                asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(barrier),"r"(24576):"memory");
+                const int k=partition*2048+step*64;
+                asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2, %3}], [%4];"
+                    ::"r"(projection_smem(s.a[slot])),"l"(&p.ffn_maps[0]),"r"(k),"r"(rm),"r"(barrier):"memory");
+                asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2, %3}], [%4];"
+                    ::"r"(projection_smem(s.b[slot])),"l"(&p.ffn_maps[1]),"r"(k),"r"(cn),"r"(barrier):"memory");
+            }
+            __syncwarp();
+        }
+        projection_wait(&s.empty[0],1); projection_wait(&s.empty[1],1);
+    } else if (w>=3 && w<7) {
+        const int warp=w-3;
+        typename Op::FragmentC acc; acc.clear();
+        Op mma;
+        for (int step=0;step<32;++step) {
+            const int slot=step&1;
+            projection_wait(&s.ready[slot],(step/2)&1);
+            typename Op::IteratorA ai({s.a[slot],typename Op::LayoutA(64)},lane);
+            typename Op::IteratorB bi({s.b[slot],typename Op::LayoutB(64)},lane);
+            ai.add_tile_offset({warp%2,0}); bi.add_tile_offset({0,warp/2});
+            typename Op::FragmentA af[2]; typename Op::FragmentB bf[2];
+            ai.set_kgroup_index(0);bi.set_kgroup_index(0);ai.load(af[0]);bi.load(bf[0]);++ai;++bi;
+            #pragma unroll
+            for (int group=0;group<4;++group) {
+                if(group<3) {ai.set_kgroup_index(group+1);bi.set_kgroup_index(group+1);ai.load(af[(group+1)&1]);bi.load(bf[(group+1)&1]);++ai;++bi;}
+                if(group==2) {__syncwarp();if(lane==0)projection_arrive(&s.empty[slot]);}
+                typename Op::TransformedFragmentA at;typename Op::TransformedFragmentB bt;
+                mma.transform(at,bt,af[group&1],bf[group&1]);mma(acc,at,bt,acc);
+            }
+        }
+        typename Op::IteratorC store({s.result,CutlassRow(136)},lane);
+        store.add_tile_offset({warp%2,warp/2});store.store(acc);
+    }
+    __syncthreads();
+    if (threadIdx.x==0) {
+        for(int i=0;i<2;++i) {
+            asm volatile("mbarrier.inval.shared::cta.b64 [%0];" ::"r"(projection_smem(&s.ready[i])):"memory");
+            asm volatile("mbarrier.inval.shared::cta.b64 [%0];" ::"r"(projection_smem(&s.empty[i])):"memory");
+        }
+    }
+    __syncthreads();
+}
