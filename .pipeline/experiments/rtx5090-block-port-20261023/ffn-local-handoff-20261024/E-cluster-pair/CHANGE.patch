+// Both FFN GEMMs retain the K16 MMA sequence. TMA uses K32/64B swizzle here.
+// FFN2's A operand is gathered from resident ACT (local shared or mapped DSM).
+__device__ __forceinline__ void resident_gemm(const Params &p, ResidentStorage &s,
+        int rm,int cn,int partition,bool expand,const CutlassB *act) {
+    using Op=ResidentOp;
+    const int w=int(threadIdx.x)/32,lane=int(threadIdx.x)%32;
+    const int iterations=expand?96:64;
+    if(threadIdx.x==0) {
+        for(int i=0;i<2;++i) {
+            asm volatile("mbarrier.init.shared::cta.b64 [%0], 1;"::"r"(projection_smem(&s.ready[i])):"memory");
+            asm volatile("mbarrier.init.shared::cta.b64 [%0], 4;"::"r"(projection_smem(&s.empty[i])):"memory");
+        }
+        asm volatile("fence.proxy.async.shared::cta;":::"memory");
+    }
+    __syncthreads();
+    if(w==0) {
+        for(int step=0;step<iterations;++step) {
+            const int slot=step&1;
+            if(step>=2)projection_wait(&s.empty[slot],((step/2)-1)&1);
+            if(!expand) {
+                typename Op::LayoutA layout(32);
+                for(int i=lane*8;i<16*32;i+=32*8)
+                    *reinterpret_cast<uint4*>(s.a[slot]+layout({i/32,i%32}))=
+                        *reinterpret_cast<const uint4*>(act+(i/32)*2048+step*32+i%32);
+            }
+            __syncwarp();
+            if(lane==0) {
+                const unsigned barrier=projection_smem(&s.ready[slot]);
+                const int bytes=expand?9216:8192;
+                asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;"::"r"(barrier),"r"(bytes):"memory");
+                if(expand) {
+                    asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2, %3}], [%4];"
+                        ::"r"(projection_smem(s.a[slot])),"l"(&p.resident_maps[0]),"r"(step*32),"r"(rm),"r"(barrier):"memory");
+                }
+                const int k=expand?step*32:partition*2048+step*32;
+                asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2, %3}], [%4];"
+                    ::"r"(projection_smem(s.b[slot])),"l"(&p.resident_maps[expand?1:2]),"r"(k),"r"(cn),"r"(barrier):"memory");
+            }
+            __syncwarp();
+        }
+        projection_wait(&s.empty[0],1);projection_wait(&s.empty[1],1);
+    } else if(w>=4) {
+        const int warp=w-4;
+        Op mma;typename Op::FragmentC acc;acc.clear();
+        for(int step=0;step<iterations;++step) {
+            const int slot=step&1;
+            projection_wait(&s.ready[slot],(step/2)&1);
+            typename Op::IteratorA ai({s.a[slot],typename Op::LayoutA(32)},lane);
+            typename Op::IteratorB bi({s.b[slot],typename Op::LayoutB(32)},lane);
+            ai.add_tile_offset({0,0});bi.add_tile_offset({0,warp});
+            typename Op::FragmentA af[2];typename Op::FragmentB bf[2];
+            ai.set_kgroup_index(0);bi.set_kgroup_index(0);ai.load(af[0]);bi.load(bf[0]);++ai;++bi;
+            ai.set_kgroup_index(1);bi.set_kgroup_index(1);ai.load(af[1]);bi.load(bf[1]);
+            __syncwarp();if(lane==0)projection_arrive(&s.empty[slot]);
+            #pragma unroll
+            for(int group=0;group<2;++group) {
+                typename Op::TransformedFragmentA at;typename Op::TransformedFragmentB bt;
+                mma.transform(at,bt,af[group],bf[group]);mma(acc,at,bt,acc);
+            }
+        }
+        typename Op::IteratorC store({s.result,CutlassRow(136)},lane);
+        store.add_tile_offset({0,warp});store.store(acc);
+    }
+    __syncthreads();
+    if(threadIdx.x==0)for(int i=0;i<2;++i) {
+        asm volatile("mbarrier.inval.shared::cta.b64 [%0];"::"r"(projection_smem(&s.ready[i])):"memory");
+        asm volatile("mbarrier.inval.shared::cta.b64 [%0];"::"r"(projection_smem(&s.empty[i])):"memory");
+    }
+    __syncthreads();
+}
+__device__ __forceinline__ void resident_ffn(const Params &p,Shared &shared) {
+    auto &s=shared.tile.resident;
+#if WAM_FFN_CLUSTER_PAIR
+    auto cluster=cg::this_cluster();
+    const int rank=cluster.block_rank();
+    const int owner=int(blockIdx.x)/2,stride=int(gridDim.x)/2;
+#else
+    const int rank=0,owner=int(blockIdx.x),stride=int(gridDim.x);
+#endif
+    for(int job=owner;job<98;job+=stride) {
+        const int row=job%14,part=job/14,rm=row*16;
+        if(rank==0) {
+            for(int h=0;h<16;++h) {
+                const int cn=part*2048+h*128;
+                resident_gemm(p,s,rm,cn,part,true,nullptr);
+                for(int i=int(threadIdx.x);i<16*128;i+=THREADS) {
+                    const int r=i/128,c=i%128;
+                    const B rounded=bf(__fadd_rn(s.result[r*136+c],value(((const B*)p.w[24])[cn+c])));
+                    const B activated=gelu_value(rounded);
+                    s.act[r*2048+h*128+c]=*reinterpret_cast<const CutlassB*>(&activated);
+                    if(p.debug_modulation) {
+                        bp(p,F1)[(rm+r)*F+cn+c]=rounded;
+                        bp(p,ACT)[(rm+r)*F+cn+c]=activated;
+                    }
+                }
+                __syncthreads();
+            }
+        }
+#if WAM_FFN_CLUSTER_PAIR
+        cluster.sync(); // producer's ACT is complete; consumers may access DSM.
+        const CutlassB *act=cluster.map_shared_rank(s.act,0);
+        const int begin=rank*12,end=begin+12;
+#else
+        const CutlassB *act=s.act;
+        const int begin=0,end=24;
+#endif
+        for(int col=begin;col<end;++col) {
+            resident_gemm(p,s,rm,col*128,part,false,act);
+            const int tile=row*24+col;
+            if(threadIdx.x==0)
+                while(DeviceCounter(p.resident_commit[tile]).load(cuda::memory_order_acquire)!=part)__nanosleep(128);
+            __syncthreads();
+            resident_commit16(p,s,tile,part,7);
+            __threadfence();__syncthreads();
+            if(threadIdx.x==0)DeviceCounter(p.resident_commit[tile]).store(part+1,cuda::memory_order_release);
+            __syncthreads();
+        }
+#if WAM_FFN_CLUSTER_PAIR
+        cluster.sync(); // remote reads must finish before producer reuses shared ACT.
+#endif
+        if(threadIdx.x==0&&rank==0&&p.resident_trace) {
+            p.resident_trace[job*3]=16;p.resident_trace[job*3+1]=24;p.resident_trace[job*3+2]=1;
+        }
+    }
+}
